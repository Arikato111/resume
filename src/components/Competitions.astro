---
import type { Lang } from "../types/lang";
import info from "../data/info.json";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const msg = {
  competitions: {
    en: "Competitions",
    th: "การแข่งขัน",
  },
};
---

<div class="section-block my-4 print:my-3">
  <h2 class="font-bold text-lg text-slate-800 border-b border-slate-200 pb-1.5 mb-3 tracking-wide uppercase text-xs sm:text-sm print:text-xs print:mb-2 print:pb-1">
    {msg.competitions[lang]}
  </h2>
  <div class="space-y-3 print:space-y-2">
    {
      info.competitions[lang].map((comp) => (
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-sm print:text-xs">
          <div>
            <span class="font-bold text-slate-800">{comp.name}</span>
            <span class="text-slate-500 text-xs sm:text-sm print:text-xs ml-2">
              • {comp.level} ({comp.year})
            </span>
          </div>
          {comp.certificates && (
            <div>
              <a
                class="text-blue-600 hover:text-blue-800 underline underline-offset-2 text-xs sm:text-sm print:no-underline print:text-slate-600"
                href={`https://${comp.certificates}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Certificate
              </a>
            </div>
          )}
        </div>
      ))
    }
  </div>
</div>
