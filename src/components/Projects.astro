---
import info from "../data/info.json";
import type { Lang } from "../types/lang";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const msg = {
  project: {
    en: "Personal projects",
    th: "โปรเจกต์ส่วนตัว",
  },
};
---

<div class="section-block my-4 print:my-3">
  <h2 class="font-bold text-lg text-slate-800 border-b border-slate-200 pb-1.5 mb-3 tracking-wide uppercase text-xs sm:text-sm print:text-xs print:mb-2 print:pb-1">
    {msg.project[lang]}
  </h2>
  <div class="space-y-4 print:space-y-3">
    {
      info.projects.map((proj) => (
        <div class="group">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h3 class="font-bold text-slate-800 text-base print:text-sm group-hover:text-blue-600 transition-colors">
              {proj.name}
            </h3>
            <span>
              <a
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs sm:text-sm text-blue-600 hover:text-blue-800 underline underline-offset-2 print:no-underline print:text-slate-600"
                href={`https://${proj.link}`}
              >
                {proj.link}
              </a>
            </span>
          </div>
          
          <ul class="text-sm print:text-xs text-slate-600 space-y-1 list-disc list-inside pl-1">
            <li class="leading-relaxed">{proj.description[lang]}</li>
            <li class="leading-relaxed">
              <span class="font-medium text-slate-700">Technologies:</span> {proj.tech}
            </li>
          </ul>
        </div>
      ))
    }
  </div>
</div>
