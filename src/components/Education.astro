---
import info from "../data/info.json";
import type { Lang } from "../types/lang";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const msg = {
  education: {
    en: "Education",
    th: "ประวัติการศึกษา",
  },
  gpa: {
    en: "gpa",
    th: "เกรดเฉลี่ย",
  },
};
---

<div class="section-block my-4 print:my-3">
  <h2 class="font-bold text-lg text-slate-800 border-b border-slate-200 pb-1.5 mb-3 tracking-wide uppercase text-xs sm:text-sm print:text-xs print:mb-2 print:pb-1">
    {msg.education[lang]}
  </h2>
  <div class="space-y-3 print:space-y-2">
    {
      info.Education.map((edu) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 text-sm print:text-xs">
          <div>
            <span class="font-bold text-slate-800">{edu.school[lang]}</span>
            <span class="text-slate-600 block sm:inline sm:ml-2">
              — {edu.level[lang]}{!!edu.gpa ? ` (${msg.gpa[lang]}: ${edu.gpa})` : ""}
            </span>
          </div>
          <div class="text-slate-500 font-medium text-xs sm:text-sm print:text-xs shrink-0">
            {edu.years}
          </div>
        </div>
      ))
    }
  </div>
</div>
