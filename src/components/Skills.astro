---
import info from "../data/info.json";
import type { Lang } from "../types/lang";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const msg = {
  skills: {
    en: "Skills",
    th: "ทักษะ",
  },
  programming: {
    en: "Programming Languages",
    th: "ภาษาโปรแกรม",
  },
  frameworks: {
    en: "Frameworks",
    th: "เฟรมเวิร์ก",
  },
  tools: {
    en: "Tools",
    th: "เครื่องมือ",
  },
  networks: {
    en: "Network",
    th: "เน็ตเวิร์ก",
  },
  cybersecurity: {
    en: "Cybersecurity",
    th: "ความปลอดภัยทางไซเบอร์",
  },
};
---

<div class="section-block my-4 print:my-3">
  <h2 class="font-bold text-lg text-slate-800 border-b border-slate-200 pb-1.5 mb-3 tracking-wide uppercase text-xs sm:text-sm print:text-xs print:mb-2 print:pb-1">
    {msg.skills[lang]}
  </h2>
  
  <div class="space-y-2 print:space-y-1.5 text-sm print:text-xs">
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
      <span class="font-semibold text-slate-700 w-44 shrink-0">{msg.programming[lang]}:</span>
      <span class="text-slate-600 leading-relaxed">{info.skills["programming"]}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
      <span class="font-semibold text-slate-700 w-44 shrink-0">{msg.frameworks[lang]}:</span>
      <span class="text-slate-600 leading-relaxed">{info.skills["frameworks"]}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
      <span class="font-semibold text-slate-700 w-44 shrink-0">{msg.tools[lang]}:</span>
      <span class="text-slate-600 leading-relaxed">{info.skills["tools"]}</span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
      <span class="font-semibold text-slate-700 w-44 shrink-0">{msg.networks[lang]}:</span>
      <span class="text-slate-600 leading-relaxed">{info.skills["networks"]}</span>
    </div>
  </div>
</div>
