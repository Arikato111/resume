---
import info from "../data/info.json";
import type { Lang } from "../types/lang";
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const msg = {
  email: {
    en: "email",
    th: "อีเมล",
  },
  website: {
    en: "Website",
    th: "เว็บไซต์",
  },
  phone: {
    en: "Phone",
    th: "เบอร์โทร",
  },
  line: {
    en: "Line ID",
    th: "ไอดีไลน์",
  },
};
---

<div class="contact-box flex flex-wrap justify-center sm:justify-between items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-slate-600 print:text-xs print:gap-x-3 my-3">
  <div class="flex items-center gap-1.5">
    <span class="font-medium text-slate-500">GitHub:</span>
    <a
      class="text-blue-600 hover:text-blue-800 font-semibold underline underline-offset-2 transition-colors print:no-underline print:text-slate-900"
      href={`https://github.com/${info.personal.github}`}
      target="_blank"
      rel="noopener noreferrer"
      >{info.personal.github}</a
    >
  </div>
  <div class="flex items-center gap-1.5">
    <span class="font-medium text-slate-500">{msg.email[lang]}:</span>
    <a 
      class="text-blue-600 hover:text-blue-800 underline underline-offset-2 transition-colors print:no-underline print:text-slate-900" 
      href={`mailto:${info.personal.email}`}
      >{info.personal.email}</a
    >
  </div>
  <div class="flex items-center gap-1.5">
    <span class="font-medium text-slate-500">{msg.website[lang]}:</span>
    <a 
      href={`https://${info.personal.website}`} 
      target="_blank"
      rel="noopener noreferrer"
      class="text-blue-600 hover:text-blue-800 underline underline-offset-2 transition-colors print:no-underline print:text-slate-900"
      >{info.personal.website}</a
    >
  </div>
  <div class="hidden flex items-center gap-1.5" id="phone-block">
    <span class="font-medium text-slate-500">{msg.phone[lang]}:</span>
    <span id="phone-value" class="font-medium text-slate-800"></span>
  </div>
  <div class="hidden flex items-center gap-1.5" id="line-block">
    <span class="font-medium text-slate-500">{msg.line[lang]}:</span>
    <span id="line-value" class="font-medium text-slate-800"></span>
  </div>
</div>

<script is:inline>
  function setLine(line) {
    const line_div = document.getElementById("line-block");
    const line_value = document.getElementById("line-value");

    line_div.classList.remove("hidden");
    line_value.innerText = line;
  }
  function setPhone(phone) {
    const phone_div = document.getElementById("phone-block");
    const phone_value = document.getElementById("phone-value");

    phone_div.classList.remove("hidden");
    phone_value.innerText = phone;
  }
  const urlSearchParams = new URLSearchParams(window.location.search);
  const params = Object.fromEntries(urlSearchParams.entries());
  if (params.phone) {
    console.log(params.phone);
    setPhone(params.phone);
  }
  if (params.line) {
    console.log(params.line);
    setLine(params.line);
  }
  if (params.print != undefined) {
    window.print();
  }
</script>

<style>
  a {
    text-decoration: none;
  }
</style>
