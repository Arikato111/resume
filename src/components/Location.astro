---
import info from "../data/info.json";
import type { Lang } from "../types/lang";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const msg = {
  location: {
    th: "ที่อยู่ปัจจุบัน",
    en: "Current Address",
  },
  address: {
    th: "รามคำแหง 2 แขวงดอกไม้ เขตประเวศ กรุงเทพมหานคร 10250",
    en: "Ramkhamhaeng 2, Dokmai Subdistrict, Prawet District, Bangkok 10250",
  },
};
---

<div class="section-block my-3 text-sm print:text-xs">
  <div class="flex items-center gap-2 text-slate-700">
    <span class="font-semibold text-slate-800">{msg.location[lang]}:</span>
    <span class="text-slate-600">{info.personal.location[lang]}</span>
  </div>
</div>
