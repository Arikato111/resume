---
import Layout from "../layouts/Layout.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Education from "../components/Education.astro";
import info from "../data/info.json";
import Contacts from "../components/Contacts.astro";
import Competitions from "../components/Competitions.astro";
import BlackLine from "../components/BlackLine.astro";
import Header from "../components/Header.astro";
import type { Lang } from "../types/lang";
import Location from "../components/Location.astro";
import ResumeLink from "../components/ResumeLink.astro";
const lang: Lang = "th";
---

<Layout title={info.common.title[lang]}>
  <Header lang={lang} />
  <div class="resume-wrapper">
    <main>
      <header class="text-center mb-6">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 print:text-2xl print:mb-1 mb-2">
          {info.personal.name[lang]}
        </h1>
        <Contacts lang={lang} />
        <div class="max-w-3xl mx-auto my-4 text-sm sm:text-base text-slate-600 print:text-xs print:my-2 print:text-slate-700 leading-relaxed text-center sm:text-justify">
          {info.personal.description[lang]}
        </div>
      </header>

      <Location lang={lang} />
      <BlackLine />
      <Skills lang={lang} />
      <BlackLine />
      <Projects lang={lang} />
      <BlackLine />
      <Competitions {lang} />
      <BlackLine />
      <Education {lang} />
      <BlackLine />
      <ResumeLink {lang} />
    </main>
  </div>
</Layout>
